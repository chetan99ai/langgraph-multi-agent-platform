# 🎛️ THE LIBERTY TOGGLE: Set to "local" (for Groq) or "aws" (for AWS Bedrock)
ENV_TARGET="local"

# --- Token Required for 'local' Flag ---
GROQ_API_KEY="<create this API key from Groq official website: https://groq.com>"

# --- Tokens Required for 'aws' Flag ---
AWS_REGION="AWS_REGION"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_if_testing_aws_locally"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_if_testing_aws_locally"

# --- Generic Email Configurations (Shared by Both) ---
SENDER_EMAIL="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-actual-16-digit-gmail-app-password"
SMTP_SERVER=""
SMTP_PORT="587"
